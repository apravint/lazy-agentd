# Example user unit. Prefer generating units for your own setup with:
#   lazy-agentd --generate-systemd --output-dir ~/.config/systemd/user [options]
# Enable only the .socket; this service is started on the first connection.

[Unit]
Description=lazy-agentd on-demand daemon
Requires=lazy-agentd.socket
After=lazy-agentd.socket

[Service]
Type=simple
# %h is your home directory; this is where `pip install --user` puts scripts.
ExecStart=%h/.local/bin/lazy-agentd --idle-timeout 900
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
